{
  "manifest_version": 3,
  "name": "FACEIT Discord RPC",
  "version": "0.1.0",
  "description": "Shows your live FACEIT CS2 match in Discord Rich Presence.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:42157/*", "http://localhost:42157/*"],
  "content_scripts": [
    {
      "matches": ["https://*.faceit.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FACEIT Discord RPC"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "faceit-rpc@example.com"
    }
  }
}
